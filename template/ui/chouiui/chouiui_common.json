      {
        "default@chouiui.x_default": {}
      },
      {
        "hover@chouiui.x_hover": {}
      },
      {
        "pressed@chouiui.x_pressed": {}
      }
    ]
  },
  "java_cell_image_panel": {
    "type": "panel",
